# Region Atlas PC worker. Copia a .env.worker y rellena secretos localmente.

REGION_ATLAS_PC_WORKER_ID=windows-pc-worker

PRICE_WORKER_SFTP_HOST=
PRICE_WORKER_SFTP_PORT=22
PRICE_WORKER_SFTP_USER=
PRICE_WORKER_SFTP_PASSWORD=
PRICE_WORKER_REMOTE_DIR=price-worker
PRICE_WORKER_PUBLIC_URL=

REGION_ATLAS_BASE_URL=https://www.regionatlas.games
LOCAL_GAME_RUNNER_TOKEN=
LOCAL_GAME_RUNNER_ID=windows-pc-game-runner

# 1 para que este PC ejecute tambien la rueda automatica periodica.
PRICE_PC_DAILY_ENABLED=0
PRICE_PC_WORKER_INTERVAL=120
PRICE_PC_LOCK_TTL_SECONDS=1800
PRICE_PC_DAILY_INTERVAL_MINUTES=180

# TodoConsolas semanal: PC-only, categorías públicas y publicación siempre por Git.
# Permanece apagado hasta validar el primer ciclo y activarlo de forma explícita.
PRICE_PC_TODOCONSOLAS_WEEKLY_ENABLED=0
# Corte local de emergencia: 1 prevalece incluso sobre una orden segura del admin.
PRICE_PC_TODOCONSOLAS_WEEKLY_HARD_DISABLED=0
PRICE_PC_TODOCONSOLAS_WEEKLY_INTERVAL_DAYS=7
PRICE_PC_TODOCONSOLAS_WEEKLY_PAGES_PER_RUN=2
PRICE_PC_TODOCONSOLAS_WEEKLY_DELAY_SECONDS=6
PRICE_PC_TODOCONSOLAS_WEEKLY_JITTER_SECONDS=2
PRICE_PC_TODOCONSOLAS_WEEKLY_BACKOFF_HOURS=24
# Vacío recorre todas las plataformas configuradas. Ejemplo: ps4,ps5,switch2
PRICE_PC_TODOCONSOLAS_WEEKLY_PLATFORMS=

# Opcional para collectors con IA/API.
OPENAI_API_KEY=
GAME_DESCRIPTION_MODEL=gpt-4o-mini
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SERPAPI_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# Research Engine V2 (local, research-only)
RESEARCH_ENGINE_ENABLED=0
RESEARCH_LLM_MODEL=gpt-4o-mini
RESEARCH_VISION_MODEL=gpt-4o-mini
RESEARCH_STRONG_MODEL=
RESEARCH_MAX_COST_USD=1.00
# Sólo para modelos no incluidos en scanner-models.ts (USD por millón de tokens).
RESEARCH_MODEL_INPUT_USD_PER_MILLION=
RESEARCH_MODEL_OUTPUT_USD_PER_MILLION=
RESEARCH_ARTIFACT_DIR=artifacts/research-engine
RESEARCH_BROWSER_EXECUTABLE_PATH=
# Proveedor primario de búsqueda web e imágenes. El valor real vive sólo en .env.worker.
BRAVE_SEARCH_API_KEY=
# Retrieval hardening: los reintentos técnicos no consumen el presupuesto semántico.
RESEARCH_SEARCH_TIMEOUT_MS=12000
RESEARCH_PAGE_TIMEOUT_MS=12000
RESEARCH_BROWSER_TIMEOUT_MS=20000
RESEARCH_IMAGE_SEARCH_TIMEOUT_MS=12000
RESEARCH_PREFLIGHT_IMAGE_URL=https://www.regionatlas.games/catalog-covers/ps3/ac-regional-2026-09-13/original/o109.jpg
RESEARCH_MAX_TECHNICAL_RETRIES=1
RESEARCH_PAGE_TECHNICAL_RETRIES=1
RESEARCH_RETRY_BASE_MS=100
# Límites máximos por campo/caso del piloto 2; no sustituyen el preflight obligatorio.
RESEARCH_PILOT_MAX_SEARCHES=25
RESEARCH_PILOT_MAX_PAGES=30
RESEARCH_PILOT_MAX_IMAGES=20
RESEARCH_PILOT_MAX_AGENT_TURNS=12
RESEARCH_PILOT_MAX_BROWSER_SESSIONS=8
RESEARCH_PILOT_MAX_TOKENS=40000
RESEARCH_PILOT_MAX_COST_USD=0.20
# Opcional: dos o más modelos separados por coma para el benchmark comparativo.
RESEARCH_BENCHMARK_MODELS=
RESEARCH_BENCHMARK_IMAGE_URL=
RESEARCH_BENCHMARK_EXPECTED_COMPONENT=BACK
