# =============================================================================
# Region Atlas — variables de entorno
# Copia a .env.local para desarrollo. En Vercel: Settings → Environment Variables
# =============================================================================

# --- Web (Vercel: Production + Preview recomendado) --------------------------
NEXT_PUBLIC_SITE_URL=https://www.regionatlas.games

# Sesión de login (Vercel Production obligatorio; Preview recomendado)
# Generar: openssl rand -base64 32
# SESSION_SECRET=

# --- Usuarios persistentes (Vercel) ------------------------------------------
# Conecta Storage → Blob al proyecto. Vercel añade BLOB_STORE_ID automáticamente.
# BLOB_STORE_ID=
# Para probar Blob en local, copia BLOB_READ_WRITE_TOKEN del dashboard de Vercel.
# BLOB_READ_WRITE_TOKEN=

# Alternativa solo local/servidor con disco (no usar en Vercel si hay Blob)
# APP_DATA_DIR=/ruta/escribible

# --- Email — enlace mágico (Vercel Production; Preview opcional) -------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Region Atlas <noreply@regionatlas.games>

# --- Solicitudes de catálogo (fichas pendientes → desarrollador) ------------
# CATALOG_REQUEST_TO_EMAIL=tu-email@dominio.com

# --- Panel admin catálogo ----------------------------------------------------
# Emails con acceso a /admin (separados por coma). En dev sin variable = cualquier usuario logueado.
# ADMIN_EMAILS=tu-email@dominio.com
# Hook opcional de Vercel Deploy (Settings → Git → Deploy Hooks) tras publicar una ficha
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
# Permite además escribir catalog.json en disco (solo local / servidor con datos)
# ADMIN_ALLOW_CATALOG_WRITE=0
# Activa cambios de catálogo en caliente usando Vercel Blob. Déjalo apagado para evitar
# operaciones Blob en páginas públicas si publicas cambios mediante deploy normal.
# CATALOG_RUNTIME_OVERLAY_ENABLED=0

# Solo para entornos de demostración sin pagos reales. Mantener apagado en producción.
# DEMO_PLAN_UPGRADE_ENABLED=0

# --- Cron de Vercel ----------------------------------------------------------
# Secreto largo compartido por las rutas /api/cron/*.
# CRON_SECRET=
# Mantener a 0. Solo permite cron sin firma propia cuando la petición lleva cabeceras de Vercel.
# ALLOW_UNSIGNED_VERCEL_CRON=0

# --- Assets públicos (opcional; vercel.json ya define portadas en build) -------
NEXT_PUBLIC_COVERS_BASE_URL=https://www.puntoracing.net/MEDIAREGIONATLAS/covers
# NEXT_PUBLIC_PLATFORMS_BASE_URL=https://www.puntoracing.net/MEDIAREGIONATLAS/platforms

# --- Portadas FTP/SFTP (solo .env.local, subida a puntoracing) ---------------
# COVERS_FTP_HOST=home424401959.1and1-data.host
# COVERS_FTP_PORT=22
# COVERS_FTP_USER=
# COVERS_FTP_PASSWORD=
# COVERS_FTP_PROTOCOL=sftp
# COVERS_FTP_REMOTE_ROOT=MEDIAPUNTORACINGWEB/MEDIAREGIONATLAS/covers
# COVERS_FTP_TLS=1
# NEWS_FTP_REMOTE_ROOT=MEDIAPUNTORACINGWEB/MEDIAREGIONATLAS/news
# NEWS_CACHE_REMOTE_URL=https://www.puntoracing.net/MEDIAREGIONATLAS/news/news-cache.json
# OPENAI_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
# SERPAPI_KEY=
# SERPAPI_API_KEY=
# REGION_VISION_DISABLED=1
# PAL_ES_RETRO_ROOT=/Volumes/Nuevo vol/pal-es-retro
# COVERS_ROOT=/Volumes/Nuevo vol/pal-es-retro/covers

# --- Afiliados / Dónde comprar ----------------------------------------------
# Apagado por defecto: si no está a 1/true, no se muestran ofertas externas.
# AFFILIATE_OFFERS_ENABLED=false
# AFFILIATE_OFFERS_CACHE_TTL_MINUTES=360
# AFFILIATE_MIN_CONFIDENCE_TO_SHOW=0.85
# AFFILIATE_MIN_CONFIDENCE_RELATED=0.65
# AFFILIATE_OFFERS_PRODUCTION_WHITELIST=true
# AFFILIATE_MOCK_PROVIDER_ENABLED=false

# eBay global. Activar solo en local cuando tengamos credenciales finales.
# EBAY_AFFILIATE_ENABLED=false
# ENABLE_EBAY_PRICE_WHEEL=0
# EBAY_ENV=production
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_OAUTH_TOKEN_ENDPOINT=https://api.ebay.com/identity/v1/oauth2/token
# EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
# EBAY_BROWSE_API_BASE=https://api.ebay.com/buy/browse/v1
# EBAY_MARKETPLACE_ID=EBAY_ES
# EBAY_CATALOG_API_BASE=https://api.ebay.com/commerce/catalog/v1_beta
# EBAY_CATALOG_API_ENABLED=false
# EBAY_CAMPAIGN_ID=
# EBAY_CUSTOM_ID_PREFIX=rag
# EBAY_CONTEXTUAL_COUNTRY=ES
# EBAY_CONTEXTUAL_ZIP=
# EBAY_AFFILIATE_LIMIT=6
# Opcional: píxel de impresión de eBay Partner Network.
# Puedes pegar la URL completa o construirla con las piezas oficiales de la campaña.
# EBAY_AFFILIATE_IMPRESSION_PIXEL_URL=
# EBAY_AFFILIATE_MPT=
# EBAY_AFFILIATE_MKCID=1
# EBAY_AFFILIATE_MKRID=1185-53479-19255-0
# EBAY_AFFILIATE_MKEVT=2
# EBAY_AFFILIATE_SITE_ID=186
# EBAY_AFFILIATE_AD_TYPE=0
# EBAY_AFFILIATE_TOOL_ID=20012
# EBAY_AFFILIATE_CUSTOM_ID=region-atlas-games

# Amazon afiliados vía Creators API. Desactivado si no está explicitamente enabled.
# AMAZON_AFFILIATE_ENABLED=false
# AMAZON_ASSOCIATE_TAG=
# AMAZON_CREATORS_CREDENTIAL_ID=
# AMAZON_CREATORS_CREDENTIAL_SECRET=
# AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
# AMAZON_MARKETPLACE=www.amazon.es
# AMAZON_LANGUAGES_OF_PREFERENCE=es_ES
# AMAZON_CURRENCY_OF_PREFERENCE=EUR
# AMAZON_SEARCH_INDEX=VideoGames
# AMAZON_AFFILIATE_LIMIT=4
# Nota: AMAZON_ACCESS_KEY / AMAZON_SECRET_KEY son PA-API antiguas y no sirven para Creators API.

# Rakuten Advertising. Preparado, pero desactivado por defecto hasta aprobación real.
# RAKUTEN_AFFILIATE_ENABLED=false
# RAKUTEN_ACCOUNT_ID=
# RAKUTEN_CLIENT_ID=
# RAKUTEN_CLIENT_SECRET=
# RAKUTEN_TOKEN_KEY=
# RAKUTEN_TOKEN_ENDPOINT=https://api.linksynergy.com/token
# RAKUTEN_TOKEN_REFRESH_SAFETY_SECONDS=300
# RAKUTEN_TOKEN_MAX_RETRIES=2
# RAKUTEN_TOKEN_TIMEOUT_MS=10000
# RAKUTEN_TOKEN_INCLUDE_GRANT_TYPE=false
# RAKUTEN_DEFAULT_CURRENCY=EUR
# RAKUTEN_PRODUCT_SEARCH_ENDPOINT=
# RAKUTEN_WEB_SECURITY_TOKEN=
# RAKUTEN_ADVANCED_REPORTS_ENABLED=false

# --- Login con Google (Vercel Production + Preview) --------------------------
# 1. Google Cloud Console → Credentials → OAuth client (Web)
# 2. Redirect URI autorizada:
#    https://www.regionatlas.games/api/auth/google/callback
#    https://regionatlas.games/api/auth/google/callback
#    http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
