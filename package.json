    "smoke:ebay-auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-ebay-auth.mjs",
    "smoke:ebay-search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-ebay-search.mjs",
    "analyze:game-facets-coverage": "node scripts/analyze-game-facets-coverage.mjs",
    "validate:game-facets-taxonomy-audit-v1": "node scripts/validate-game-facets-taxonomy-audit-v1.mjs",
    "analyze:game-genre-quality": "node scripts/analyze-game-genre-quality.mjs",
    "validate:game-genre-data-quality-audit-v1": "node scripts/validate-game-genre-data-quality-audit-v1.mjs",
    "normalize:game-genres:dry-run": "node scripts/normalize-game-genres-dry-run.mjs",
    "normalize:game-genres:apply": "node scripts/normalize-game-genres-apply.mjs",
    "validate:game-genre-normalization-v1": "node scripts/validate-game-genre-normalization-v1.mjs",
    "validate:game-genre-normalization-apply-v1": "node scripts/validate-game-genre-normalization-apply-v1.mjs",
    "validate:game-facets-v1": "node scripts/validate-game-facets-v1.mjs"
