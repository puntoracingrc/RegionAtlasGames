# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.worker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auth (cuentas locales)
/data/users.json
/data/auth/
/data/admin/
.env.local

# colecciones de usuario (importaciones Excel)
/data/collections/

# mercado entre usuarios
/data/marketplace/
/public/listing-photos/

# detalles públicos individuales generados en build
/public/catalog-details/by-id/

# portadas en disco externo (symlink local — no subir a git/vercel)
/public/covers
public/covers

# datos pesados en disco externo (symlinks locales — ver npm run storage:setup)
/data/museum
/data/pc
/data/price-ingest
/data/catalog-discovery/
/data/wikidata
/data/serialstation
/data/descriptions
/data/covers
/data/local-caches

# informes locales de pipelines (regenerables)
/data/*-enrich-report.json
/data/ingest-recency.json

# logs de cron / scripts
/logs/
/data/logs/
/data/worker-runtime/

# ingest eBay (token + caché local — resto de price-ingest en disco externo)
/data/price-ingest/ebay-token-cache.json
/data/price-ingest/cache/
/data/price-ingest/reports/

# Rakuten advertiser discovery local output
/data/rakuten-advertiser-candidates.local.json
/data/rakuten-advertiser-review.local.json

# Backups locales pesados del catálogo
/data/_catalog_backup_gg.json

# Genre normalization local dry-run report
/data/game-genre-normalization-report.local.json
/data/game-genre-normalization-apply-report.local.json
/data/backups/
