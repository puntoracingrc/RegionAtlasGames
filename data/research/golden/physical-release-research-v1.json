      "expectedForbidden": "GENERIC_EUROPE_BOX"
    },
    {
      "id": "n64-euu-no-country-map",
      "ruleId": "n64-euu-not-country-map",
      "expectedForbidden": "EUU_EQUALS_FR_DE"
    },
    {
      "id": "n64-same-barcode-different-boxes",
      "ruleId": "n64-barcode-shared",
      "expectedRuleContains": "Do not merge variants"
    },
    {
      "id": "n64-label-minus-one-not-rom-revision",
      "ruleId": "n64-label-minus-one-not-rom-rev",
      "expectedForbidden": "ROM_REVISION_FROM_LABEL_SUFFIX"
    },
    {
      "id": "n64-bundle-inner-cart-no-new-game",
      "ruleId": "n64-bundle-same-inner-game",
