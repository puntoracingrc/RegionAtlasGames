  "runtimeUse": "FORBIDDEN",
  "cases": [
    {
      "id": "liberation-hd-ps3-digital-only",
      "kind": "PHYSICAL_TAXONOMY",
      "input": { "digitalOnly": true },
      "expected": "DIGITAL_ONLY"
    },
    {
      "id": "shadows-gold-ps5-canceled-physical",
      "kind": "PHYSICAL_TAXONOMY",
      "input": { "canceledPhysical": true },
      "expected": "CANCELED_PHYSICAL"
    },
    {
      "id": "shadows-target-steelbook-bonus-no-game",
      "kind": "PHYSICAL_TAXONOMY",
      "input": { "bonusItemOnly": true, "gameIncluded": false, "steelbook": true },
      "expected": "BONUS_ITEM_ONLY"
    },
    {
      "id": "black-flag-resynced-deluxe-standalone-digital",
      "kind": "PHYSICAL_TAXONOMY",
      "input": { "digitalOnly": true, "standalone": true },
      "expected": "DIGITAL_ONLY"
    },
    {
      "id": "ezio-collection-switch-code-sku",
      "kind": "PHYSICAL_TAXONOMY",
      "input": { "codeInBox": true },
      "expected": "CODE_IN_BOX"
    },
    {
      "id": "shadows-switch2-game-key-card",
      "kind": "PHYSICAL_TAXONOMY",
      "input": { "gameKeyCard": true },
      "expected": "GAME_KEY_CARD"
    },
    {
      "id": "american-saga-xbox360-liberation-component",
      "kind": "COMPONENT_CONTENT",
      "input": { "component": "Liberation HD", "observedForm": "printed download voucher" },
      "expected": "VOUCHER"
    },
    {
      "id": "xbox360-bles-platform-conflict",
      "kind": "PLATFORM_IDENTIFIER",
      "input": { "platformSlug": "xbox360", "identifier": "BLES-01234" },
      "expected": "PLATFORM_IDENTIFIER_CONFLICT"
    },
    {
      "id": "spain-retailer-not-spanish-packaging",
      "kind": "REGION_EVIDENCE",
      "input": { "retailerCountry": "Spain", "exactPackageObserved": false },
      "expected": "EVIDENCE_MARKET_ONLY"
    }
  ],
  "n64Cases": [
    {
      "id": "n64-cart-eur-family-only",
      "ruleId": "n64-eur-not-national-package",
