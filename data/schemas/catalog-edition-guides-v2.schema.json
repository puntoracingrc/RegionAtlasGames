{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.regionatlas.games/schemas/catalog-edition-guides-v2.schema.json",
  "title": "RegionAtlas catalog physical edition guides",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "guides"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "guides": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/legacyGuide" },
          { "$ref": "#/$defs/physicalGuide" }
        ]
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "url", "thumbnailUrl", "width", "height", "caption"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "placement": { "enum": ["GALLERY", "CONTENTS"] },
        "url": { "type": "string", "minLength": 1 },
        "thumbnailUrl": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "evidenceType": { "$ref": "#/$defs/evidenceType" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "thumbnailSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "originalUrl": { "type": "string", "minLength": 1 },
        "originalWidth": { "type": "integer", "minimum": 1 },
        "originalHeight": { "type": "integer", "minimum": 1 },
        "originalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourcePageUrl": { "type": "string", "format": "uri" },
        "inspectedAt": { "type": "string", "format": "date" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformSlug", "slug", "region", "edition"],
      "properties": {
        "platformSlug": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 }
      }
    },
    "legacyGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "reviewedAt", "note", "editions", "images", "sources", "evidenceNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" },
        "note": { "type": "string" },
        "editions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["catalogId", "identity", "label", "description", "imageKeys"],
            "properties": {
              "catalogId": { "type": "string", "minLength": 1 },
              "identity": { "$ref": "#/$defs/identity" },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "imageKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          }
        },
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "evidenceNote": { "type": "string" }
      }
    },
    "broadRegion": {
      "enum": ["EUROPE", "NORTH_AMERICA", "LATIN_AMERICA", "ASIA", "OCEANIA", "MIDDLE_EAST", "AFRICA", "OTHER"]
    },
    "marketRegion": {
      "enum": [
        "ES", "PT", "FR", "IT", "DE", "AT", "CH", "GB", "IE", "BE", "NL", "LU",
        "DK", "SE", "NO", "FI", "PL", "CZ", "SK", "HU", "RO", "BG", "GR", "TR", "RU", "UA",
        "US", "CA", "MX", "BR", "AR", "CL", "CO", "PE",
        "JP", "KR", "HK", "TW", "CN", "SG", "MY", "TH", "ID", "PH", "IN",
        "AU", "NZ", "AE", "SA", "QA", "KW", "BH", "OM", "ZA", "MZ", "AO"
      ]
    },
    "editionType": {
      "enum": ["STANDARD", "COMPILATION", "BUDGET_REISSUE", "SPECIAL", "COLLECTOR", "DELUXE", "GOLD", "LIMITED", "STEELBOOK", "OTHER"]
    },
    "priceCondition": {
      "enum": ["sealed", "newRetail", "complete", "gameManual", "loose"]
    },
    "variantConfidence": {
      "enum": ["CONFIRMED_PHYSICAL_COPY", "CONFIRMED", "HIGH", "PENDING_IDENTIFIER", "UNCONFIRMED"]
    },
    "releaseStatus": {
      "enum": ["RELEASED", "CANCELED_PHYSICAL_RELEASE"]
    },
    "physicalContentStatus": {
      "enum": [
        "PHYSICAL_FULL_GAME", "PHYSICAL_DOWNLOAD_REQUIRED", "GAME_KEY_CARD", "CODE_IN_BOX",
        "COLLECTOR_WITHOUT_GAME", "DIGITAL_ONLY", "CANCELED_PHYSICAL",
        "PROMOTIONAL_NOT_FOR_RESALE", "PRESS_KIT", "RETAILER_BUNDLE", "HARDWARE_BUNDLE",
        "UNKNOWN_PHYSICAL_STATUS"
      ]
    },
    "physicalProductType": {
      "enum": [
        "NATIVE_GAME_DISC", "NATIVE_GAME_CARD", "GAME_KEY_CARD",
        "PREVIOUS_GEN_DISC_WITH_UPGRADE", "DOWNLOAD_CODE_IN_BOX",
        "PROMOTIONAL_NOT_FOR_RESALE", "PRESS_KIT", "RETAILER_BUNDLE", "HARDWARE_BUNDLE",
        "COLLECTOR_WITHOUT_GAME", "DIGITAL_ONLY_PRODUCT", "UNKNOWN_PHYSICAL_PRODUCT"
      ]
    },
    "researchStatus": {
      "enum": ["UNCONFIRMED", "PENDING_REVIEW", "PHYSICAL_VARIANT_NOT_CONFIRMED"]
    },
    "evidenceType": {
      "enum": ["REAL_SCAN", "REAL_PHOTO", "UNBOXING_FRAME", "RETAILER_PHOTO_CONFIRMED", "RETAILER_ASSET", "PUBLISHER_MOCKUP", "PRE_RELEASE_ASSET", "PUBLISHER_DOCUMENTATION", "OWNER_CONFIRMATION", "UNKNOWN"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "supports"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/evidenceType" },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "summary": { "type": "string" },
        "supports": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "componentLanguageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "languages", "basis", "exhaustive"],
      "properties": {
        "component": { "enum": ["BOX", "OUTER_BOX", "INNER_GAME", "FRONT", "BACK", "SPINE", "MANUAL", "OTHER"] },
        "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
        "basis": { "enum": ["OBSERVED", "DECLARED"] },
        "exhaustive": { "type": "boolean" },
        "note": { "type": "string" },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "priceIdentity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "stickers": { "type": "array", "items": { "type": "string" } },
        "markings": { "type": "array", "items": { "type": "string" } },
        "barcode": { "type": "string" },
        "boxCode": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scanSetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "priceIdentity": { "type": "string", "minLength": 1 }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthCm", "heightCm", "depthCm", "approximate", "sourceLabel", "notes"],
      "properties": {
        "widthCm": { "type": "number", "exclusiveMinimum": 0 },
        "heightCm": { "type": "number", "exclusiveMinimum": 0 },
        "depthCm": { "type": "number", "exclusiveMinimum": 0 },
        "approximate": { "type": "boolean" },
        "comparisonImageUrl": { "type": "string", "pattern": "^/" },
        "sourceLabel": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string" } },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "widthCm", "heightCm", "depthCm", "sourceLabel", "sourceUrl"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "widthCm": { "type": "number", "exclusiveMinimum": 0 },
            "heightCm": { "type": "number", "exclusiveMinimum": 0 },
            "depthCm": { "type": "number", "exclusiveMinimum": 0 },
            "sourceLabel": { "type": "string", "minLength": 1 },
            "sourceUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "physicalEdition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "broadRegion", "editionType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "broadRegion": { "$ref": "#/$defs/broadRegion" },
        "editionType": { "$ref": "#/$defs/editionType" },
        "releaseStatus": { "$ref": "#/$defs/releaseStatus" },
        "marketRegions": { "type": "array", "items": { "$ref": "#/$defs/marketRegion" }, "uniqueItems": true },
        "evidenceMarkets": { "type": "array", "items": { "$ref": "#/$defs/marketRegion" }, "uniqueItems": true },
        "distributionMarkets": { "type": "array", "items": { "$ref": "#/$defs/marketRegion" }, "uniqueItems": true },
        "packagingLanguages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "softwareLanguages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "componentLanguageEvidence": { "type": "array", "items": { "$ref": "#/$defs/componentLanguageEvidence" } },
        "ratingSystems": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "softwareFamilyCodes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "productCodes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "physicalContentStatus": { "$ref": "#/$defs/physicalContentStatus" },
        "physicalProductType": { "$ref": "#/$defs/physicalProductType" },
        "nativePhysicalPlatform": { "type": "string", "minLength": 1 },
        "compatiblePlatforms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "containsDisc": { "type": "boolean" },
        "hasGameCard": { "type": "boolean" },
        "gameStoredOnCard": { "type": "boolean" },
        "fullGameDownloadRequired": { "type": "boolean" },
        "physicalGameCardCount": { "type": "integer", "minimum": 0 },
        "gameKeyCardCount": { "type": "integer", "minimum": 0 },
        "physicalGameCount": { "type": "integer", "minimum": 0 },
        "countsAsNativePhysicalRelease": { "type": "boolean" },
        "upgradeToPS5": { "type": "boolean" },
        "upgradePath": { "type": "string", "minLength": 1 },
        "redeems": { "type": "string", "minLength": 1 },
        "requiresBaseGame": { "type": "boolean" },
        "expansionOf": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/variantConfidence" },
        "barcode": { "type": "string" },
        "catalogNumber": { "type": "string" },
        "serial": { "type": "string" },
        "boxCode": { "type": "string" },
        "releaseDate": { "type": "string", "format": "date" },
        "releaseDateContext": { "type": "string", "minLength": 1 },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "physicalContents": { "type": "array", "items": { "type": "string" } },
        "digitalContents": { "type": "array", "items": { "type": "string" } },
        "sharedDiscId": { "type": "string" },
        "catalogIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scanSetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "imageKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "includesEditionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "includesVariantIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "containsCatalogIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "physicalBonusItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "relatedGameId", "type", "market", "includesGame"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "relatedGameId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["STEELBOOK_CASE"] },
        "retailer": { "type": "string", "minLength": 1 },
        "market": { "$ref": "#/$defs/marketRegion" },
        "upc": { "type": "string", "minLength": 1 },
        "includesGame": { "const": false },
        "catalogIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relatedRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "expansionOf"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["EXPANSION"] },
        "expansionOf": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "editionFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "representativeCatalogId", "physicalEditionIds", "priceConditions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "representativeCatalogId": { "type": "string", "minLength": 1 },
        "priceConditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/priceCondition" },
          "uniqueItems": true
        },
        "physicalEditionIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "sharedDisc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "technicalRegion": { "$ref": "#/$defs/broadRegion" },
        "serial": { "type": "string" },
        "xemid": { "type": "string" },
        "mediaId": { "type": "string" },
        "ratingSystems": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "researchTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/researchStatus" },
        "marketRegions": { "type": "array", "items": { "$ref": "#/$defs/marketRegion" }, "uniqueItems": true },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "physicalGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "title", "reviewedAt", "note", "game", "physicalEditions", "evidence", "sources", "evidenceNote"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" },
        "note": { "type": "string" },
        "game": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "platformSlug", "canonicalCatalogId"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "platformSlug": { "type": "string", "minLength": 1 },
            "canonicalCatalogId": { "type": "string", "minLength": 1 },
            "canonicalGameId": { "type": "string", "minLength": 1 },
            "platformReleaseId": { "type": "string", "minLength": 1 },
            "aliases": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "editionFamilies": { "type": "array", "items": { "$ref": "#/$defs/editionFamily" } },
        "physicalEditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/physicalEdition" } },
        "physicalBonusItems": { "type": "array", "items": { "$ref": "#/$defs/physicalBonusItem" } },
        "relatedReleases": { "type": "array", "items": { "$ref": "#/$defs/relatedRelease" } },
        "sharedDiscs": { "type": "array", "items": { "$ref": "#/$defs/sharedDisc" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "evidenceNote": { "type": "string" },
        "researchTasks": { "type": "array", "items": { "$ref": "#/$defs/researchTask" } }
      }
    }
  }
}
