{
  "schemaVersion": 1,
  "sources": [
    {
      "id": "regionatlas-own-scan",
      "hosts": ["regionatlas.games", "www.regionatlas.games"],
      "platforms": ["*"],
      "countries": ["*"],
      "roles": ["OWN_SCAN", "PHYSICAL_SCAN"],
      "accessModes": ["INTERNAL"],
      "fieldCapabilities": {
        "BARCODE": 100,
        "BOX_CODE": 100,
        "SERIAL": 100,
        "PRODUCT_CODE": 100,
        "MARKET_REGION": 100,
        "PACKAGING_LANGUAGES": 100,
        "RATING": 100,
        "OUTER_INNER_RELATION": 100,
        "BUNDLE_CONTENTS": 100,
        "COLLECTOR_CONTENTS": 100
      },
      "defaultReliability": 100,
      "knownRisks": ["The scan proves only the photographed specimen and visible components."],
      "queryTemplates": []
    },
    {
      "id": "publisher-official",
      "hosts": [],
      "platforms": ["*"],
      "countries": ["*"],
      "roles": ["PUBLISHER", "OFFICIAL_SOURCE_CANDIDATE"],
      "accessModes": ["DIRECT_FETCH", "SEARCH_ENGINE", "DOMAIN_SEARCH", "BROWSER", "ARCHIVE"],
      "fieldCapabilities": {
        "PHYSICAL_EXISTENCE": 96,
        "PHYSICAL_PRODUCT_TYPE": 92,
        "RELEASE_STATUS": 96,
        "BUNDLE_CONTENTS": 92,
        "COLLECTOR_CONTENTS": 92,
        "SOFTWARE_LANGUAGES": 80
      },
      "defaultReliability": 92,
      "knownRisks": ["Announcement and preorder pages do not prove that a physical product reached retail."],
      "queryTemplates": ["site:{HOST} \"{TITLE}\" \"{EDITION}\" {PLATFORM}"]
    },
    {
      "id": "platform-holder-official",
      "hosts": ["nintendo.com", "playstation.com", "xbox.com"],
      "platforms": ["*"],
      "countries": ["*"],
      "roles": ["PLATFORM_HOLDER", "OFFICIAL_SOURCE_CANDIDATE"],
      "accessModes": ["DIRECT_FETCH", "SEARCH_ENGINE", "DOMAIN_SEARCH", "BROWSER", "ARCHIVE"],
      "fieldCapabilities": {
        "PHYSICAL_EXISTENCE": 94,
        "PHYSICAL_PRODUCT_TYPE": 90,
        "RELEASE_STATUS": 94,
        "PRODUCT_CODE": 86,
        "SOFTWARE_LANGUAGES": 84
      },
      "defaultReliability": 90,
      "knownRisks": ["Digital store pages do not prove a physical release or its packaging."],
      "queryTemplates": ["site:{HOST} \"{TITLE}\" {PLATFORM}"]
    },
    {
      "id": "national-retailer",
      "hosts": ["game.es", "fnac.es", "mediamarkt.es"],
      "platforms": ["*"],
      "countries": ["ES"],
      "roles": ["RETAILER"],
      "accessModes": ["DIRECT_FETCH", "SEARCH_ENGINE", "DOMAIN_SEARCH", "BROWSER", "ARCHIVE"],
      "fieldCapabilities": {
        "PHYSICAL_EXISTENCE": 84,
        "BARCODE": 90,
        "EVIDENCE_MARKET": 80,
        "MARKET_REGION": 60,
        "RELEASE_STATUS": 70,
        "PACKAGING_LANGUAGES": 20
      },
      "defaultReliability": 72,
      "knownRisks": ["Retailer country proves circulation, not automatically packaging market.", "Mockups may differ from released packaging."],
      "queryTemplates": ["site:{HOST} \"{BARCODE}\"", "site:{HOST} \"{TITLE}\" \"{EDITION}\""],
      "physicalImageCapabilities": { "realSpecimenImages": false, "frontImages": true, "backImages": false, "spineImages": false, "cartImages": false, "discImages": false, "outerPackageImages": false, "innerContentsImages": false, "gallery": false, "originalImages": true, "componentLabels": false, "regionLabels": false, "listingIds": true, "accessRisk": ["front-render-only", "market-does-not-prove-packaging"] }
    },
    {
      "id": "ebay",
      "hosts": ["ebay.com", "ebay.es", "ebay.co.uk"],
      "platforms": ["*"],
      "countries": ["*"],
      "roles": ["MARKETPLACE", "PHYSICAL_SPECIMEN_DISCOVERY"],
      "accessModes": ["MARKETPLACE_API", "SEARCH_ENGINE", "BROWSER", "IMAGE_SEARCH"],
      "fieldCapabilities": {
        "PHYSICAL_EXISTENCE": 60,
        "BARCODE": 68,
        "PRODUCT_CODE": 45,
        "PHYSICAL_PRODUCT_TYPE": 55,
        "OUTER_INNER_RELATION": 48,
        "PACKAGING_LANGUAGES": 72,
        "COLLECTOR_CONTENTS": 70,
        "MARKET_REGION": 20
      },
      "defaultReliability": 52,
      "knownRisks": ["Aggregated product pages can mix identifiers from multiple variants.", "Seller country and seller-entered metadata are weak evidence."],
      "queryTemplates": ["site:ebay.com \"{BARCODE}\"", "site:ebay.es \"{TITLE}\" {PLATFORM}"]
    },
    {
      "id": "todocoleccion",
      "hosts": ["todocoleccion.net", "www.todocoleccion.net"],
      "platforms": ["*"],
      "countries": ["ES"],
      "roles": ["MARKETPLACE", "PHYSICAL_SPECIMEN_DISCOVERY"],
      "accessModes": ["SEARCH_ENGINE", "BROWSER", "IMAGE_SEARCH"],
      "fieldCapabilities": {
        "PHYSICAL_EXISTENCE": 62,
        "BARCODE": 72,
        "PACKAGING_LANGUAGES": 78,
        "COLLECTOR_CONTENTS": 74,
        "EVIDENCE_MARKET": 55
      },
      "defaultReliability": 55,
      "knownRisks": ["Seller descriptions are weak; exact listing photos can be strong component evidence."],
      "queryTemplates": ["site:todocoleccion.net \"{BARCODE}\"", "site:todocoleccion.net \"{TITLE}\" {PLATFORM}"],
      "physicalImageCapabilities": { "realSpecimenImages": true, "frontImages": true, "backImages": true, "spineImages": false, "cartImages": false, "discImages": false, "outerPackageImages": true, "innerContentsImages": false, "gallery": true, "originalImages": true, "componentLabels": false, "regionLabels": false, "listingIds": true, "accessRisk": ["listing-expiry", "cropped-thumbnails", "seller-metadata"] }
    },
    {
      "id": "ubisoft-official",
      "hosts": ["ubisoft.com", "news.ubisoft.com", "store.ubisoft.com"],
      "platforms": ["*"],
      "countries": ["*"],
      "roles": ["PUBLISHER", "OFFICIAL_SOURCE_CANDIDATE"],
      "accessModes": ["DIRECT_FETCH", "DOMAIN_SEARCH", "BROWSER", "ARCHIVE"],
      "fieldCapabilities": { "CANONICAL_IDENTITY": 94, "PHYSICAL_EXISTENCE": 90, "PHYSICAL_PRODUCT_TYPE": 86, "BUNDLE_CONTENTS": 88, "COLLECTOR_CONTENTS": 90, "RELEASE_STATUS": 92 },
      "defaultReliability": 92,
      "knownRisks": ["Official marketing may omit regional packaging identifiers and can describe digital editions."],
      "queryTemplates": ["site:ubisoft.com \"{TITLE}\" \"{EDITION}\" {PLATFORM}", "site:news.ubisoft.com \"{TITLE}\" {PLATFORM}"]
    },
    {
      "id": "nintendo-official",
      "hosts": ["nintendo.es", "nintendo-europe.com", "nintendo.com"],
      "platforms": ["ds", "wiiu", "switch"],
      "countries": ["ES", "EU"],
      "roles": ["PLATFORM_HOLDER", "OFFICIAL_SOURCE_CANDIDATE"],
      "accessModes": ["DIRECT_FETCH", "DOMAIN_SEARCH", "BROWSER", "ARCHIVE"],
      "fieldCapabilities": { "CANONICAL_IDENTITY": 88, "PRODUCT_CODE": 90, "PHYSICAL_PRODUCT_TYPE": 86, "SOFTWARE_LANGUAGES": 82, "RELEASE_STATUS": 88 },
      "defaultReliability": 90,
      "knownRisks": ["Digital store entries do not establish a physical SKU or outer packaging."],
      "queryTemplates": ["site:nintendo.es \"{TITLE}\" {PLATFORM} {PRODUCT_CODE}", "site:nintendo-europe.com \"{TITLE}\" {PLATFORM}"]
    },
    {
      "id": "dbox",
      "hosts": ["dbox.tools", "dbox.space"],
      "platforms": ["ds", "wiiu", "switch", "xbox360"],
      "countries": ["*"],
      "roles": ["SPECIALIZED_DATABASE", "PHYSICAL_SPECIMEN_DISCOVERY"],
      "accessModes": ["DIRECT_FETCH", "DOMAIN_SEARCH", "BROWSER", "IMAGE_SEARCH"],
      "fieldCapabilities": { "BARCODE": 82, "BOX_CODE": 90, "PRODUCT_CODE": 88, "OUTER_INNER_RELATION": 88, "CANONICAL_IDENTITY": 70, "PACKAGING_LANGUAGES": 76 },
      "defaultReliability": 76,
      "knownRisks": ["Bind every code to the photographed component and exact regional variant."],
      "queryTemplates": ["site:dbox.tools \"{BARCODE}\"", "site:dbox.space \"{BARCODE}\"", "site:dbox.tools \"{TITLE}\" {PLATFORM}", "site:dbox.space \"{PRODUCT_CODE}\""]
    },
    {
      "id": "doesitplay",
      "hosts": ["doesitplay.org"],
      "platforms": ["ps5", "switch", "xbox-series"],
      "countries": ["*"],
      "roles": ["SPECIALIZED_DATABASE", "TECHNICAL_PHYSICAL_STATUS"],
      "accessModes": ["DIRECT_FETCH", "DOMAIN_SEARCH", "BROWSER"],
      "fieldCapabilities": { "PHYSICAL_PRODUCT_TYPE": 90, "MEDIA_REVISION": 82, "RELEASE_STATUS": 80 },
      "defaultReliability": 82,
      "knownRisks": ["Technical installability does not by itself establish regional packaging identity."],
      "queryTemplates": ["site:doesitplay.org \"{TITLE}\" \"{PLATFORM}\"", "site:doesitplay.org \"{TITLE}\" \"download required\""]
    },
    {
      "id": "ogdb",
      "hosts": ["ogdb.eu"],
      "platforms": ["*"],
      "countries": ["EU"],
      "roles": ["SPECIALIZED_DATABASE", "PHYSICAL_SPECIMEN_DISCOVERY"],
      "accessModes": ["DIRECT_FETCH", "DOMAIN_SEARCH", "BROWSER", "IMAGE_SEARCH"],
      "fieldCapabilities": { "BARCODE": 82, "PRODUCT_CODE": 84, "BOX_CODE": 78, "CANONICAL_IDENTITY": 76, "PACKAGING_LANGUAGES": 66 },
      "defaultReliability": 76,
      "knownRisks": ["Database records can aggregate editions; verify exact images and region."],
      "queryTemplates": ["site:ogdb.eu \"{TITLE}\" {PLATFORM}", "site:ogdb.eu \"{BARCODE}\""]
    },
    {
      "id": "retroplace",
      "hosts": ["retroplace.com"],
      "platforms": ["ds", "wiiu", "xbox360"],
      "countries": ["EU"],
      "roles": ["SPECIALIZED_DATABASE", "PHYSICAL_SPECIMEN_DISCOVERY"],
      "accessModes": ["DIRECT_FETCH", "DOMAIN_SEARCH", "BROWSER", "IMAGE_SEARCH"],
      "fieldCapabilities": { "BARCODE": 76, "BOX_CODE": 78, "PRODUCT_CODE": 78, "CANONICAL_IDENTITY": 72 },
      "defaultReliability": 70,
      "knownRisks": ["Community records require exact subject and component validation."],
      "queryTemplates": ["site:retroplace.com \"{TITLE}\" {PLATFORM}", "site:retroplace.com \"{BARCODE}\""],
      "physicalImageCapabilities": { "realSpecimenImages": false, "frontImages": false, "backImages": false, "spineImages": false, "cartImages": false, "discImages": false, "outerPackageImages": false, "innerContentsImages": false, "gallery": true, "originalImages": false, "componentLabels": false, "regionLabels": true, "listingIds": true, "accessRisk": ["aggregate-variants", "placeholder-gallery"] }
    },
    {
      "id": "mobygames",
      "hosts": ["mobygames.com"],
      "platforms": ["*"],
      "countries": ["*"],
      "roles": ["SPECIALIZED_DATABASE", "RELEASE_IDENTITY"],
      "accessModes": ["DIRECT_FETCH", "DOMAIN_SEARCH", "BROWSER"],
      "fieldCapabilities": { "CANONICAL_IDENTITY": 76, "RELEASE_STATUS": 72, "MARKET_REGION": 65 },
      "defaultReliability": 72,
      "knownRisks": ["Release groups and cover galleries may combine regional variants."],
      "queryTemplates": ["site:mobygames.com \"{TITLE}\" {PLATFORM}"]
    },
    {
      "id": "gamefaqs-guarded",
      "hosts": ["gamefaqs.gamespot.com"],
      "platforms": ["ps4", "ps5", "n64", "gameboy", "ds", "wiiu", "switch", "xbox360"],
      "countries": ["*"],
      "roles": ["DISCOVERY_ONLY", "STRUCTURED_RELEASE_LEAD", "REGIONAL_IDENTIFIER_DISCOVERY", "REGIONAL_TITLE_DISCOVERY"],
      "accessModes": ["DOMAIN_SEARCH", "BROWSER"],
      "fieldCapabilities": { "CANONICAL_IDENTITY": 58, "RELEASE_STATUS": 55 },
      "discoveryCapabilities": ["REGIONAL_IDENTIFIER", "REGIONAL_TITLE", "BARCODE_CANDIDATE", "RELEASE_MAP"],
      "confirmationCapabilities": [],
      "negativeEvidenceCapabilities": [],
      "defaultReliability": 52,
      "knownRisks": ["Discovery only: walkthrough counters and ASCII art are not product identifiers; never confirm a physical identifier from this source."],
      "queryTemplates": ["site:gamefaqs.gamespot.com \"{TITLE}\" {PLATFORM} release data", "site:gamefaqs.gamespot.com \"{TITLE}\" {PLATFORM} UPC JAN product code"]
    },
    {
      "id": "libretro-thumbnails",
      "hosts": ["github.com", "raw.githubusercontent.com", "thumbnails.libretro.com"],
      "platforms": ["ps4", "ps5", "n64", "gameboy"],
      "countries": ["*"],
      "roles": ["DISCOVERY_ONLY", "REGIONAL_RELEASE_LEAD", "REGIONAL_TITLE_LEAD", "IMAGE_URL_DISCOVERY"],
      "accessModes": ["DOMAIN_SEARCH", "DIRECT_FETCH", "BROWSER"],
      "fieldCapabilities": { "CANONICAL_IDENTITY": 35, "MARKET_REGION": 15, "ROM_REVISION": 20 },
      "discoveryCapabilities": ["REGIONAL_RELEASE", "REGIONAL_TITLE", "REVISION", "IMAGE_URL"],
      "confirmationCapabilities": [],
      "negativeEvidenceCapabilities": [],
      "defaultReliability": 40,
      "knownRisks": ["Discovery only; reused or missing thumbnails do not prove or disprove a physical variant.", "Never use source absence as negative evidence."],
      "queryTemplates": ["site:github.com/libretro-thumbnails \"{TITLE}\" {PLATFORM}", "site:thumbnails.libretro.com \"{TITLE}\""]
    },
    {
      "id": "launchbox-images",
      "hosts": ["gamesdb.launchbox-app.com"],
      "platforms": ["*"],
      "countries": ["*"],
      "roles": ["PHYSICAL_SPECIMEN_DISCOVERY", "COVER_GALLERY"],
      "accessModes": ["DIRECT_FETCH", "SEARCH_ENGINE", "BROWSER", "IMAGE_SEARCH"],
      "fieldCapabilities": { "BARCODE": 65, "BOX_CODE": 60, "PRODUCT_CODE": 55, "PHYSICAL_PRODUCT_TYPE": 60, "PACKAGING_LANGUAGES": 62 },
      "defaultReliability": 55,
      "knownRisks": ["Community cover galleries can mix regions; only exact readable component photos are eligible."],
      "queryTemplates": ["site:gamesdb.launchbox-app.com \"{TITLE}\" {PLATFORM} back"],
      "physicalImageCapabilities": { "realSpecimenImages": true, "frontImages": true, "backImages": true, "spineImages": true, "cartImages": true, "discImages": true, "outerPackageImages": true, "innerContentsImages": true, "gallery": true, "originalImages": true, "componentLabels": true, "regionLabels": true, "listingIds": true, "accessRisk": ["mixed-regions", "community-labels"] }
    },
    {
      "id": "yambalu",
      "hosts": ["yambalu.com", "www.yambalu.com"],
      "platforms": ["*"],
      "countries": ["ES"],
      "roles": ["RETAILER_AGGREGATOR", "RELEASE_IDENTITY"],
      "accessModes": ["SEARCH_ENGINE", "DIRECT_FETCH", "BROWSER"],
      "fieldCapabilities": { "CANONICAL_IDENTITY": 76, "PHYSICAL_EXISTENCE": 68, "BUNDLE_CONTENTS": 62, "OUTER_INNER_RELATION": 30 },
      "defaultReliability": 58,
      "knownRisks": ["Product naming can be localized; identifiers and component relationships require stronger corroboration."],
      "queryTemplates": ["site:yambalu.com \"{TITLE}\" {PLATFORM}", "site:yambalu.com \"{BARCODE}\""]
    },
    {
      "id": "serialstation",
      "hosts": ["serialstation.com", "www.serialstation.com"],
      "platforms": ["ps1", "ps2", "ps3", "ps4", "psp", "psvita"],
      "countries": ["*"],
      "roles": ["TECHNICAL_DATABASE", "COMPONENT_IDENTIFIER"],
      "accessModes": ["DIRECT_FETCH", "DOMAIN_SEARCH", "BROWSER"],
      "fieldCapabilities": { "PRODUCT_CODE": 94, "SERIAL": 96, "MEDIA_ID": 88, "CANONICAL_IDENTITY": 82, "MARKET_REGION": 20 },
      "defaultReliability": 88,
      "knownRisks": ["Technical identifier families establish platform/technical region, not a national distribution market.", "Bind a serial to the photographed disc or package component."],
      "queryTemplates": ["site:serialstation.com \"{SERIAL}\"", "site:serialstation.com \"{PRODUCT_CODE}\"", "site:serialstation.com \"{TITLE}\" {PLATFORM}"]
    },
    {
      "id": "redump",
      "hosts": ["redump.org", "redump.info"],
      "platforms": ["ps1", "ps2", "ps3", "ps4", "ps5", "psp", "xbox", "xbox360", "xboxone", "xboxseries", "gamecube", "wii", "wiiu", "saturn", "dreamcast", "neogeocd"],
      "countries": ["*"],
      "roles": ["TECHNICAL_DATABASE", "MEDIA_IDENTIFIER"],
      "accessModes": ["DOMAIN_SEARCH", "BROWSER"],
      "fieldCapabilities": { "PRODUCT_CODE": 88, "SERIAL": 90, "MEDIA_ID": 96, "MEDIA_REVISION": 92, "CANONICAL_IDENTITY": 78, "MARKET_REGION": 10, "PACKAGING_LANGUAGES": 0 },
      "defaultReliability": 90,
      "knownRisks": ["Disc/dump identity is not national packaging or distribution proof.", "Coverage varies by platform and title; absence is not evidence of absence."],
      "queryTemplates": ["site:redump.org \"{SERIAL}\"", "site:redump.org \"{TITLE}\" {PLATFORM}"]
    },
    {
      "id": "no-intro",
      "hosts": ["no-intro.org", "wiki.no-intro.org"],
      "platforms": ["nes", "snes", "n64", "gameboy", "gbc", "gba", "ds", "3ds", "switch", "mastersystem", "megadrive", "gamegear", "neogeo", "neogeopocket"],
      "countries": ["*"],
      "roles": ["TECHNICAL_DATABASE", "CARTRIDGE_IDENTIFIER"],
      "accessModes": ["DOMAIN_SEARCH", "BROWSER"],
      "fieldCapabilities": { "PRODUCT_CODE": 92, "ROM_REVISION": 96, "CANONICAL_IDENTITY": 82, "MARKET_REGION": 10, "BOX_CODE": 0, "PACKAGING_LANGUAGES": 0 },
      "defaultReliability": 90,
      "knownRisks": ["ROM/cartridge evidence does not prove box, manual or national packaging.", "Undumped and discovery records are not released-package inventories."],
      "queryTemplates": ["site:wiki.no-intro.org \"{PRODUCT_CODE}\"", "site:no-intro.org \"{TITLE}\" {PLATFORM}"]
    },
    {
      "id": "datomatic",
      "hosts": ["datomatic.no-intro.org"],
      "platforms": ["nes", "snes", "n64", "gameboy", "gbc", "gba", "ds", "3ds", "switch", "mastersystem", "megadrive", "gamegear", "neogeo", "neogeopocket"],
      "countries": ["*"],
      "roles": ["TECHNICAL_DATABASE", "CARTRIDGE_IDENTIFIER"],
      "accessModes": ["DOMAIN_SEARCH", "BROWSER"],
      "fieldCapabilities": { "PRODUCT_CODE": 92, "ROM_REVISION": 96, "CANONICAL_IDENTITY": 82, "MARKET_REGION": 10, "BOX_CODE": 0, "PACKAGING_LANGUAGES": 0 },
      "defaultReliability": 90,
      "knownRisks": ["Technical dump metadata cannot be propagated to box or manual components.", "Technical region is not national distribution market."],
      "queryTemplates": ["site:datomatic.no-intro.org \"{PRODUCT_CODE}\"", "site:datomatic.no-intro.org \"{TITLE}\" {PLATFORM}"]
    }
  ]
}
